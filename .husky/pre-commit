#!/usr/bin/env sh

# 1. PurgeCSS runs on EVERYTHING (no lint-staged)
echo "🧹 1/4: Cleaning up unused CSS (Whole Repo)..."
pnpm exec purgecss --config ./purgecss.config.js
git add common.css

# 2. Regenerate the HTML outline (h1-h3) so README's link never goes stale
echo "📑 2/4: Regenerating KONSPEKT.md..."
pnpm run --silent konspekt
git add KONSPEKT.md

# 3. Link guard: broken links, orphan pages, missing files in cwiczenia.js stop the commit (PYT-084a)
echo "🔗 3/4: Checking links..."
pnpm run --silent linki || exit 1

# 4. Prettier runs ONLY on the files you are committing (using lint-staged)
echo "💅 4/4: Formatting staged files with Prettier..."
pnpm exec lint-staged