#!/usr/bin/env sh

# 1. PurgeCSS runs on EVERYTHING (no lint-staged)
echo "🧹 1/3: Cleaning up unused CSS (Whole Repo)..."
pnpm exec purgecss --config ./purgecss.config.js
git add common.css

# 2. Regenerate the HTML outline (h1-h3) so README's link never goes stale
echo "📑 2/3: Regenerating KONSPEKT.md..."
pnpm run --silent konspekt
git add KONSPEKT.md

# 3. Prettier runs ONLY on the files you are committing (using lint-staged)
echo "💅 3/3: Formatting staged files with Prettier..."
pnpm exec lint-staged