      "b": "camera",
      "bSide": "top",
      "id": "switch-camera",
    },
  ],
  "presets": [
    {
      "id": "p24",
      "lesson": "Maska /24: wszystkie urządzenia są w sieci 10.10.10.0. Laptop wysyła do Drukarki bezpośrednio, przez sam Switch – tak jak w Symulatorze ARP.",
      "settings": {
        "phase": "there",
        "prefix": 24,
        "target": "printer",
        "trap": false,
      },
      "title": "/24: jedna sieć",
    },
    {
      "id": "p25",
      "lesson": "Ten sam Switch i te same kable, a ramka robi objazd przez Router. Maska /25 postawiła płot na adresie .128: Laptop (.105) jest przed płotem, Drukarka (.130) za płotem – w innej sieci.",
      "settings": {
        "phase": "there",
        "prefix": 25,
        "target": "printer",
        "trap": false,
      },
      "title": "/25: płot na .128",
    },
    {
      "id": "p26",
      "lesson": "Laptop jest w sieci .64–.127, a jego brama 10.10.10.1 leży w sieci .0–.63. Laptop nie ma komu oddać ramki. Naprawa: wpisz na Laptopie bramę z jego sieci – Router ma tam adres 10.10.10.65.",
      "settings": {
        "phase": "there",
        "prefix": 26,
        "target": "nas",
        "trap": false,
      },
      "title": "/26: brama za płotem",
    },
    {
      "id": "trap",
      "lesson": "Tam: Laptop (/24) uważa Serwer NAS za swojego i wysyła bezpośrednio. Z powrotem: Serwer NAS (/26) uważa Laptop za obcego i odpowiada przez Router. Bez bramy odpowiedź by nie wróciła. Kierunek zmienisz w Trybie swobodnym.",
      "settings": {
        "phase": "back",
        "prefix": 24,
        "target": "nas",
        "trap": true,
      },
      "title": "Pułapka: różne maski",
    },
  ],
}
`;

